# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# Cle API Google Gemini (obtenir sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=votre_cle_gemini_ici

# Nom du bucket S3 pour stocker les selfies
S3_BUCKET_NAME=votre-bucket-s3

# Les credentials AWS doivent etre configures via:
# aws configure
# ou via le fichier ~/.aws/credentials
